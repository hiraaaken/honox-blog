{
  "name": "honox-blog",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["hverlin.mise-vscode"]
    }
  },
  // ローカルのフォルダ名に依存せずコンテナ内パスを固定する。
  // devcontainers.nvim等がLSPメッセージのURIをこのworkspaceFolder基準で
  // ホスト⇄コンテナ変換するため、パスを明示しておくと定義ジャンプや診断が安定する。
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/honox-blog,type=bind",
  "workspaceFolder": "/workspaces/honox-blog",
  "forwardPorts": [5173],
  "postCreateCommand": "mise trust && mise install && aube install"
}
