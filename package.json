{
  "name": "basic",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:theme": "node scripts/theme.check.mjs",
    "check": "tsc --noEmit && node scripts/check-contrast.mjs && node scripts/theme.check.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "ignore"
    }
  },
  "dependencies": {
    "@shikijs/rehype": "^4.5.0",
    "hast-util-to-string": "^3.0.1",
    "hono": "4.11.7",
    "honox": "0.1.62",
    "lineicons": "^1.3.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/vite-ssg": "^0.3.3",
    "@mdx-js/rollup": "^3.1.1",
    "@types/hast": "3.0.5",
    "@types/mdx": "^2.0.14",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "wrangler": "^4.154.0"
  }
}
